# The generated cloud-rest-api section is served by the normal docs
# machinery: table of contents, endpoint rendering, search, and completion.
# A self-contained fixture bundle under $WORK/restcache keeps this test
# independent of the shared cache fixture.

env NO_COLOR=1

# Section TOC lists the v5 and v6 subtopics.
ptyexec ./k6 x docs --cache-dir $WORK/restcache --version v0.55.x cloud-rest-api
stdout 'Grafana Cloud k6 REST API'
stdout '- v5'
stdout '- v6'

# An endpoint page renders its full markdown.
ptyexec ./k6 x docs --cache-dir $WORK/restcache --version v0.55.x cloud-rest-api/v6/load_tests_list
stdout 'load_tests_list'
stdout 'Invocation'

# Unified search finds the endpoint.
ptyexec ./k6 x docs --cache-dir $WORK/restcache --version v0.55.x search load
stdout 'load_tests_list'

# Completion offers the top-level section and its version children.
env K6_DOCS_CACHE_DIR=$WORK/restcache
env K6_DOCS_VERSION=v0.55.x
exec ./k6 __complete x docs ''
stdout 'cloud-rest-api'
stdout ':4'

exec ./k6 __complete x docs cloud-rest-api ''
stdout 'v5'
stdout 'v6'

