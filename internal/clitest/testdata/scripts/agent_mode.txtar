# Non-TTY serves the same content as TTY, just without ANSI styling.

# No args — table of contents, not the old markdown-dir guide.
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x
stdout '# k6 v0.55.x'
! stdout 'Recipes'
! stdout 'directory of markdown files'

# Topic args — topic content.
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a fn-one
stdout 'modA.fnOne'
! stdout '# k6 docs'

# Search — results.
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search k6
stdout 'k6-mod-a'
! stdout '# k6 docs'
