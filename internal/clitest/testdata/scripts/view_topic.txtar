# Section with children shows subtopics footer
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a
stdout '# k6/mod-a'
stdout 'The mod-a module'
stdout 'mod-a subtopics:'
stdout '- fn-one'
stdout '- fn-two'
stdout '- child-a'

# Leaf section: no subtopics footer, frontmatter stripped
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a fn-one
stdout 'modA.fnOne'
stdout 'fn-one operation'
! stdout 'subtopics'
! stdout 'title:'

# Child names strip parent prefix (child-a-clear -> clear)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a child-a
stdout '- clear'

# Non-JS-API usage hint with slug path
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x alpha
stdout 'k6 x docs alpha/'

# Missing markdown file: section appears blank (no error shown to user).
rm $WORK/cache/markdown/gamma/_index.md
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x gamma
! stderr 'error'
! stderr 'not found'
