# Preview docs built from a local k6-docs working tree via --source.
# No download, no cache setup: the page is transformed from $WORK/src and rendered.
# NO_COLOR keeps glamour output plain so assertions match contiguous text.
env NO_COLOR=1
env HOME=$WORK/home

# No --version with --source: defaults to "next" (the in-development docs).
ptyexec ./k6 x docs --source $WORK/src using-k6 my-feature
stdout 'UNIQUEMARKER describes the configurable feature'

# Source builds live under the doc cache base, isolated in .sources/ so normal
# version discovery (which matches only vX.Y.x dirs) never sees them.
exists $WORK/home/.local/share/k6/docs/.sources

# --version overrides the "next" default to target another version directory.
ptyexec ./k6 x docs --source $WORK/src --version v1.0.x using-k6 old-page
stdout 'OLDMARKER from the released docs'

# Search runs against the local source index (matches across two categories).
ptyexec ./k6 x docs --source $WORK/src search configurable
stdout 'my-feature'

# Editing a page is reflected on the next run (stamp changes, bundle rebuilt).
cp edited.md src/docs/sources/k6/next/using-k6/my-feature.md
ptyexec ./k6 x docs --source $WORK/src using-k6 my-feature
stdout 'EDITEDMARKER describes the feature'

# A second, different source directory gets its own isolated build.
ptyexec ./k6 x docs --source $WORK/src2 using-k6 other
stdout 'OTHERMARKER from the second checkout'

# Skip-if-unchanged: the first run builds (and says so on stderr); an unchanged
# rerun is skipped (no build message); editing the source rebuilds again.
exec ./k6 x docs --source $WORK/src3
stderr 'Building k6 next docs'
exec ./k6 x docs --source $WORK/src3
! stderr 'Building k6 next docs'
cp page-edited.md src3/docs/sources/k6/next/using-k6/page.md
exec ./k6 x docs --source $WORK/src3
stderr 'Building k6 next docs'

