# Top-level categories resolve correctly
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x delta
stdout 'Delta'

env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x epsilon
stdout 'Epsilon'

env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x zeta
stdout 'Zeta'

# Subtopic under delta
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x delta sub-one
stdout 'SubOne'
