# best-practices ignores extra args
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x best-practices extra-arg
! stdout 'extra-arg'
stdout 'best practices'

# best-practices is case-sensitive
env NO_COLOR=1
! ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x Best-Practices
stderr 'topic not found'

# --version and --cache-dir inherited by search subcommand
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search k6
stdout '- k6-mod-a'

# --depth 1 shows flat subtopics (same as default)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x --depth 1 javascript-api
stdout '- k6-mod-a'
! stdout '  - fn-one'

# --depth 2 shows one level of nested children
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x --depth 2 javascript-api
stdout '- k6-mod-a'
stdout '  - fn-one'
! stdout '    -'

# --depth works on TTY TOC too
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x --depth 2
stdout '  - k6-mod-a'
