# Rule 1: slash in args[0] with multiple args → join all with /
k6-docs --cache-dir $WORK/cache --version v0.55.x javascript-api/k6-http get
cmp stdout golden-get.txt

# Rule 1: slash in later arg → error (joins to nonexistent path)
! k6-docs --cache-dir $WORK/cache --version v0.55.x http k6-http/get
stderr 'topic not found'

# Category matching is case-sensitive
! k6-docs --cache-dir $WORK/cache --version v0.55.x Using-k6 scenarios
stderr 'topic not found'

# Nonexistent slug after fallback
! k6-docs --cache-dir $WORK/cache --version v0.55.x totally-fake-module nonexistent
stderr 'topic not found'

-- golden-get.txt --
## http.get(url, [params])

Make an HTTP GET request.

import http from 'k6/http';

export default function () {
  const res = http.get('https://test-api.k6.io/');
}
