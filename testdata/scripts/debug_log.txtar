# Non-TTY logs agent mode to stderr (needs --verbose for debug-level logs)
exec ./k6 --verbose x docs --cache-dir $WORK/cache --version v0.55.x
stderr 'agent mode'

# TTY logs interactive mode.
ptyexec ./k6 --verbose x docs --cache-dir $WORK/cache --version v0.55.x
stderr 'interactive mode'

# Search does NOT emit mode debug log
exec ./k6 --verbose x docs --cache-dir $WORK/cache --version v0.55.x search k6
! stderr 'agent mode'
! stderr 'interactive mode'
