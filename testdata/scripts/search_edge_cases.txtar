# No results exact format
exec k6-docs --cache-dir $WORK/cache --version v0.55.x search zzzznotfound
cmp stdout golden-no-results.txt

# Multiple words joined by spaces
exec k6-docs --cache-dir $WORK/cache --version v0.55.x search WebSocket example content
stdout 'Results for "WebSocket example content":'

# Normalized match: spaces/dashes ignored
exec k6-docs --cache-dir $WORK/cache --version v0.55.x search cookiejar
stdout 'k6-http:'

# bare javascript-api excluded from grouping
exec k6-docs --cache-dir $WORK/cache --version v0.55.x search k6
cmp stdout golden-k6.txt
! stdout 'javascript-api:'

-- golden-no-results.txt --
Results for "zzzznotfound":

  (no results)
-- golden-k6.txt --
Results for "k6":
examples: Example k6 scripts.

k6-http: HTTP module for k6.
- cookiejar                  HTTP cookie jar.
- cookiejar/cookiejar-clear  Clear all cookies.
- get                        Make an HTTP GET request.
- post                       Make an HTTP POST request.

k6-jslib: Extended JavaScript utility library.

using-k6: Learn how to use k6.
- scenarios  Configure test scenarios.

