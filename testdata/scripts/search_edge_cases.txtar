# Empty search term returns no results
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search ''
stdout '\(no results\)'

# Fuzzy: spaces match dashed slug (topic one → topic-one)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search 'topic one'
stdout 'TopicOne'

# Fuzzy: dashes match concatenated title (sub-one → SubOne)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search sub-one
stdout 'SubOne'

# Fuzzy: spaces match slashed slug (delta sub-one → delta/sub-one)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search 'delta subone'
stdout 'SubOne'

# No results exact format
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search zzzznotfound
stdout '\(no results\)'

# Single result from multi-word search shows doc
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search TopicTwo content
stdout '# TopicTwo'

# Normalized match: single group shows doc directly
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search child-a
stdout '# ChildA'

# bare javascript-api excluded from grouping
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search k6
stdout '- k6-lib-c'
stdout '- k6-mod-a'
! stdout 'javascript-api:'
