# No results exact format
k6-docs --cache-dir $WORK/cache --version v0.55.x search zzzznotfound
cmp stdout golden-no-results.txt

# Multiple words joined by spaces
k6-docs --cache-dir $WORK/cache --version v0.55.x search TopicTwo content
stdout 'beta'

# Normalized match: spaces/dashes ignored
k6-docs --cache-dir $WORK/cache --version v0.55.x search child-a
stdout 'k6-mod-a'

# bare javascript-api excluded from grouping
k6-docs --cache-dir $WORK/cache --version v0.55.x search k6
cmp stdout golden-k6.txt
! stdout 'javascript-api:'

-- golden-no-results.txt --
(no results)
-- golden-k6.txt --
- k6-lib-c
- k6-mod-a
- k6-mod-b
