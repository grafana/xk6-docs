# Title/description match
k6-docs --cache-dir $WORK/cache --version v0.55.x search Scenarios
cmp stdout golden-scenarios.txt

# Description match grouped by JS API module
k6-docs --cache-dir $WORK/cache --version v0.55.x search 'GET request'
cmp stdout golden-get-request.txt

# Multi-group sorted alphabetically
k6-docs --cache-dir $WORK/cache --version v0.55.x search k6
cmp stdout golden-k6.txt

# Body content match
k6-docs --cache-dir $WORK/cache --version v0.55.x search 'WebSocket example content'
stdout 'examples'

# No results
k6-docs --cache-dir $WORK/cache --version v0.55.x search zzzznotfound
stdout '\(no results\)'

# Missing arg errors
! k6-docs --cache-dir $WORK/cache --version v0.55.x search
stderr 'requires at least 1 arg'

-- golden-scenarios.txt --
- testing-guides
- using-k6
-- golden-get-request.txt --
- k6-http
-- golden-k6.txt --
- examples
- k6-http
- k6-jslib
- using-k6
