# Title/description match
k6-docs --cache-dir $WORK/cache --version v0.55.x search guide
cmp stdout golden-guide.txt

# Description match grouped by JS API module
k6-docs --cache-dir $WORK/cache --version v0.55.x search 'fn-one operation'
cmp stdout golden-fn-one-operation.txt

# Multi-group sorted alphabetically
k6-docs --cache-dir $WORK/cache --version v0.55.x search k6
cmp stdout golden-k6.txt

# Body content match
k6-docs --cache-dir $WORK/cache --version v0.55.x search 'TopicTwo content'
stdout 'beta'

# No results
k6-docs --cache-dir $WORK/cache --version v0.55.x search zzzznotfound
stdout '\(no results\)'

# Missing arg errors
! k6-docs --cache-dir $WORK/cache --version v0.55.x search
stderr 'requires at least 1 arg'

-- golden-guide.txt --
- alpha
- gamma
-- golden-fn-one-operation.txt --
- k6-mod-a
-- golden-k6.txt --
- k6-lib-c
- k6-mod-a
- k6-mod-b
