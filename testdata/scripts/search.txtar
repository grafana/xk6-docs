# Title/description match
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search guide
stdout '- alpha'
stdout '- gamma'
stdout '- showcase'

# Single result from description match shows doc
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search 'fn-one operation'
stdout '## modA.fnOne'

# Multi-group sorted alphabetically
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search k6
stdout '- k6-lib-c'
stdout '- k6-mod-a'
stdout '  - fn-one'
stdout '- k6-mod-b'

# Single result from body match shows doc
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search 'TopicTwo content'
stdout '# TopicTwo'

# No results
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search zzzznotfound
stdout '\(no results\)'

# Single group goes to deepest match, not group parent
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search child-a-clear
stdout 'ChildA.clear'

# Search resolves slash args the same as space args
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search k6-mod-b/leaf-one
stdout 'LeafOne'

env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search k6-mod-b leaf-one
stdout 'LeafOne'

# Search resolves bare module name without k6- prefix
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search mod-b/leaf-one
stdout 'LeafOne'

# Search resolves full slug path
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search javascript-api k6-mod-b leaf-one
stdout 'LeafOne'

# Search --depth 1 still shows children (search overrides depth)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x --depth 1 search k6
stdout '  - fn-one'

# Missing arg errors
env NO_COLOR=1
! ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x search
stderr 'requires at least 1 arg'
