# Non-TTY mode: prints agent guide, not content.
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a fn-one
stdout '# k6 docs'
! stdout 'modA.fnOne'

# TTY + NO_COLOR: raw markdown without glamour rendering.
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a fn-one
stdout '## modA.fnOne'
