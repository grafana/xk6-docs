# Transform showcase: every rule exercised through a single topic.
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x showcase
! stdout 'title:'
! stdout '{{< code >}}'
! stdout '{{< admonition'
! stdout '{{< section >}}'
! stdout '{{< youtube'
! stdout '{{< collapse'
! stdout 'K6_VERSION'
! stdout 'hidden'
! stdout '<Glossary>'
! stdout '<DescriptionList>'
! stdout '<LdScript'
! stdout '<br'
stdout 'console.log'
stdout 'Warning:'
stdout 'Collapsed content here'
stdout 'BeforeAfter'
stdout 'some term'
stdout 'Just text, nothing special'

# Empty markdown file produces empty output (no crash).
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/empty-cache --version v0.55.x empty-topic

-- empty-cache/sections.json --
{"version":"v0.55.x","sections":[{"slug":"empty-topic","rel_path":"empty-topic.md","title":"Empty","description":"Empty.","weight":1,"category":"empty-topic","children":null,"is_index":false}]}
-- empty-cache/markdown/empty-topic.md --
