# Transform showcase: every rule exercised through a single topic.
# The golden file is the authoritative test. Assertions below aid debugging.
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x showcase
! stdout 'title:'
! stdout '{{< code >}}'
! stdout '{{< admonition'
! stdout '{{< section >}}'
! stdout '{{< youtube'
! stdout '{{< collapse'
! stdout 'K6_VERSION'
! stdout 'hidden'
! stdout '<Glossary>'
! stdout '<DescriptionList>'
! stdout '<LdScript'
! stdout '<br'
stdout 'console.log'
stdout '> \*\*Warning:\*\*'
stdout 'Collapsed content here'
stdout 'BeforeAfter'
stdout 'some term'
stdout 'Line oneLine twoLine threeLine four'
stdout 'Just text, nothing special'
cmp stdout golden-showcase.txt

# Empty markdown file produces empty output (no crash, no stray newlines).
exec ./k6 x docs --cache-dir $WORK/empty-cache --version v0.55.x empty-topic

-- golden-showcase.txt --
