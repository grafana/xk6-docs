# best-practices ignores extra args
k6-docs --cache-dir $WORK/cache --version v0.55.x best-practices extra-arg
! stdout 'extra-arg'
stdout 'best practices'

# best-practices is case-sensitive
! k6-docs --cache-dir $WORK/cache --version v0.55.x Best-Practices
stderr 'topic not found'

# --version and --cache-dir inherited by search subcommand
k6-docs --cache-dir $WORK/cache --version v0.55.x search k6
stdout '- examples'

# --depth 1 shows flat list
k6-docs --cache-dir $WORK/cache --version v0.55.x --depth 1
stdout '- javascript-api'
! stdout '  - k6-http'

# --depth 3 shows grandchildren
k6-docs --cache-dir $WORK/cache --version v0.55.x --depth 3
stdout '  - k6-http'
stdout '    - get'

# --depth flag overrides config file
env XDG_CONFIG_HOME=$WORK/depth-cfg
mkdir $WORK/depth-cfg/k6
cp depth3.yaml $WORK/depth-cfg/k6/docs.yaml
k6-docs --cache-dir $WORK/cache --version v0.55.x --depth 1
stdout '- javascript-api'
! stdout '  - k6-http'

-- depth3.yaml --
depth: 3
