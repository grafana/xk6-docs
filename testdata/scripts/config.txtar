# Invalid config warns but continues
env XDG_CONFIG_HOME=$WORK/invalid-cfg
mkdir $WORK/invalid-cfg/k6
cp invalid.yaml $WORK/invalid-cfg/k6/docs.yaml
exec k6-docs --cache-dir $WORK/cache --version v0.55.x
stdout '# k6'
stderr 'ignoring invalid config'

# Config loaded via HOME fallback (no XDG_CONFIG_HOME).
# In non-TTY mode, renderer is skipped, so we verify config doesn't break anything.
env XDG_CONFIG_HOME=
env HOME=$WORK/home
mkdir $WORK/home/.config/k6
cp cat-n.yaml $WORK/home/.config/k6/docs.yaml
exec k6-docs --cache-dir $WORK/cache --version v0.55.x http get
stdout 'http\.get'
! stderr 'ignoring invalid config'

# HOME and USERPROFILE both unset — config fails gracefully with warning
env HOME=
env USERPROFILE=
env XDG_CONFIG_HOME=
exec k6-docs --cache-dir $WORK/cache --version v0.55.x
stdout '# k6'
stderr 'neither HOME nor USERPROFILE'

# File-unreadable config (permission denied) — warning logged, continues
env XDG_CONFIG_HOME=$WORK/unreadable-cfg
mkdir $WORK/unreadable-cfg/k6
cp valid.yaml $WORK/unreadable-cfg/k6/docs.yaml
chmod 000 $WORK/unreadable-cfg/k6/docs.yaml
exec k6-docs --cache-dir $WORK/cache --version v0.55.x
stdout '# k6'
stderr 'ignoring invalid config'

# depth: 1 shows flat list (no children)
env XDG_CONFIG_HOME=$WORK/depth1-cfg
mkdir $WORK/depth1-cfg/k6
cp depth1.yaml $WORK/depth1-cfg/k6/docs.yaml
exec k6-docs --cache-dir $WORK/cache --version v0.55.x
stdout '- javascript-api'
! stdout '  - k6-http'

# depth: 3 shows grandchildren in TOC
env XDG_CONFIG_HOME=$WORK/depth3-cfg
mkdir $WORK/depth3-cfg/k6
cp depth3.yaml $WORK/depth3-cfg/k6/docs.yaml
exec k6-docs --cache-dir $WORK/cache --version v0.55.x
stdout '  - k6-http'
stdout '    - get'

# depth: 1 in section subtopics shows flat children
env XDG_CONFIG_HOME=$WORK/depth1-section-cfg
mkdir $WORK/depth1-section-cfg/k6
cp depth1.yaml $WORK/depth1-section-cfg/k6/docs.yaml
exec k6-docs --cache-dir $WORK/cache --version v0.55.x http
stdout '- cookiejar'
! stdout '  - clear'

-- invalid.yaml --
:
  :
    : [invalid
-- cat-n.yaml --
renderer: cat -n
-- valid.yaml --
renderer: cat
-- depth1.yaml --
depth: 1
-- depth3.yaml --
depth: 3
