# Section with children shows subtopics footer
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a
cmp stdout golden-mod-a.txt

# Leaf section: no subtopics footer, frontmatter stripped
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a fn-one
cmp stdout golden-mod-a-fn-one.txt
! stdout '---'
! stdout 'title:'

# Child names strip parent prefix (child-a-clear -> clear)
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a child-a
stdout '- clear'

# Non-JS-API usage hint with slug path
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x alpha
stdout 'k6 x docs alpha/'

# Missing markdown file: section appears blank (no error shown to user).
rm $WORK/cache/markdown/gamma/_index.md
exec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x gamma
! stderr 'error'
! stderr 'not found'

-- golden-mod-a.txt --
# k6/mod-a

The mod-a module.

> **Note:** Feature X is supported by default since k6 v0.55.x.

---
**mod-a subtopics:**
- fn-one
- fn-two
- child-a
- fn-one

> Example: `k6 x docs mod-a/<subtopic>`
-- golden-mod-a-fn-one.txt --
## modA.fnOne(url, [params])

Perform a fn-one operation.

import modA from 'k6/mod-a';

export default function () {
  const res = modA.fnOne('https://test.example.com/');
}
