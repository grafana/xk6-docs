# Unknown topic
env NO_COLOR=1
! ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x nonexistent-topic-xyz
stderr 'topic not found'

# Missing best_practices.md
env NO_COLOR=1
! ptyexec ./k6 x docs --cache-dir $WORK/empty-cache --version v0.55.x best-practices
stderr 'best practices'

-- empty-cache/v0.55.x/sections.json --
{"version":"v0.55.x","sections":[]}
