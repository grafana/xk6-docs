# Unknown topic
! k6-docs --cache-dir $WORK/cache --version v0.55.x nonexistent-topic-xyz
stderr 'topic not found'

# Missing best_practices.md
! k6-docs --cache-dir $WORK/empty-cache --version v0.55.x best-practices
stderr 'best practices'

