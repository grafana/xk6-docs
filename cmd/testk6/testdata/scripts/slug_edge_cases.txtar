# Rule 1: slash in args[0] with multiple args → join all with /
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x javascript-api/k6-mod-a fn-one
stdout 'modA.fnOne'

# Rule 1: slash in later arg → error (joins to nonexistent path)
env NO_COLOR=1
! ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a k6-mod-a/fn-one
stderr 'topic not found'

# Category matching is case-insensitive (resolved via index lookup)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x Alpha topic-one
stdout 'TopicOne'

# Nonexistent slug after fallback
env NO_COLOR=1
! ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x totally-fake-module nonexistent
stderr 'topic not found'
