# Full slug with /
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x javascript-api/k6-mod-a/fn-one
stdout 'modA.fnOne'
stdout 'fn-one operation'

# JS API shortcut (same output proves correct resolution)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a fn-one
stdout 'modA.fnOne'

# Case insensitive
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x MOD-A FN-ONE
stdout 'modA.fnOne'

# k6- prefix dedup
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x k6-mod-a fn-one
stdout 'modA.fnOne'

# Category prefix
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x alpha topic-one
stdout '# TopicOne'

# Parent prefix fallback (child-a/clear → child-a/child-a-clear)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x mod-a child-a clear
stdout 'ChildA.clear'

# Bare name prefers unprefixed (both lib-c and k6-lib-c exist)
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x lib-c
stdout '# lib-c'
stdout 'Utility library'

# Alias lookup resolves to the real section
env NO_COLOR=1
ptyexec ./k6 x docs --cache-dir $WORK/cache --version v0.55.x old-delta
stdout 'Delta category'
